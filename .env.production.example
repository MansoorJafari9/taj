# Copy to .env.production and replace every replace-me value.
# Existing PostgreSQL on the Docker host; adjust host and port for your setup.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=replace-me

COOKIE_SECRET=replace-me-with-a-long-random-secret
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=replace-me

# Public addresses must work from both browsers and containers.
STOREFRONT_URL=http://188.212.97.228:3001
CORS_ORIGINS=http://188.212.97.228:3001
ASSET_URL_PREFIX=http://188.212.97.228:3000/assets/
NUXT_PUBLIC_API_BASE_URL=http://188.212.97.228:3000/shop-api
NUXT_PUBLIC_CHANNEL_TOKEN=

ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
BACKEND_PORT=3000
STOREFRONT_PORT=3001
IMAGE_TAG=latest
